<div class="aiel-layout">
  <nav class="aiel-nav" aria-label="{{#str}}sections, aienglishlesson{{/str}}">
    <p>{{progress}}</p>
    <ol>{{#navigation}}<li><a href="{{url}}" {{#current}}aria-current="step"{{/current}}>{{title}}</a> {{#done}}<span aria-label="{{#str}}completed, aienglishlesson{{/str}}">✓</span>{{/done}}</li>{{/navigation}}</ol>
  </nav>
  <article class="aiel-content">
    <p class="aiel-meta">{{#str}}focus, aienglishlesson{{/str}}: {{focus}} · {{#str}}origin, aienglishlesson{{/str}}: {{origin}}</p>
    <h2>{{title}}</h2>
    {{#audiourl}}<section><h3>{{#str}}listen, aienglishlesson{{/str}}</h3><audio controls preload="none" src="{{audiourl}}">{{#str}}listen, aienglishlesson{{/str}}</audio><p>{{#str}}localvoice, aienglishlesson{{/str}}</p><details><summary>{{#str}}transcript, aienglishlesson{{/str}}</summary><div class="aiel-text">{{audioscript}}</div></details></section>{{/audiourl}}
    <div class="aiel-text">{{body}}</div>
    <div class="aiel-cards">{{#cards}}<section class="aiel-card"><h3>{{term}}</h3><details><summary>{{#str}}showmeaning, aienglishlesson{{/str}}</summary><p>{{meaning}}</p><p>{{example}}</p></details></section>{{/cards}}</div>
    {{#example}}<section class="aiel-example"><h3>{{#str}}example, aienglishlesson{{/str}}</h3><div class="aiel-text">{{example}}</div></section>{{/example}}
    {{#simpler}}<details><summary>{{#str}}simpler, aienglishlesson{{/str}}</summary><div class="aiel-text">{{simpler}}</div></details>{{/simpler}}
    {{#extraexample}}<details><summary>{{#str}}extraexample, aienglishlesson{{/str}}</summary><div class="aiel-text">{{extraexample}}</div></details>{{/extraexample}}
    {{#practice}}<section class="aiel-practice"><h3>{{#str}}practice, aienglishlesson{{/str}}</h3><div class="aiel-text">{{practice}}</div>
      {{#hint}}<details><summary>{{#str}}hint, aienglishlesson{{/str}}</summary><div class="aiel-text">{{hint}}</div></details>{{/hint}}
      {{#cansave}}<form method="post" enctype="multipart/form-data" action="{{actionurl}}" class="aiel-response-form">
        <input type="hidden" name="id" value="{{id}}"><input type="hidden" name="version" value="{{version}}"><input type="hidden" name="section" value="{{section}}"><input type="hidden" name="action" value="submit"><input type="hidden" name="sesskey" value="{{sesskey}}">
        <label for="aiel-response">{{#str}}yourresponse, aienglishlesson{{/str}}</label>
        <textarea id="aiel-response" name="response" rows="6" maxlength="12000" class="form-control">{{response}}</textarea>
        {{#speaking}}<div class="aiel-recorder my-3">
          <p>{{#str}}recordingnotice, aienglishlesson{{/str}}</p>
          <button type="button" class="btn btn-secondary" data-action="record">{{#str}}record, aienglishlesson{{/str}}</button>
          <button type="button" class="btn btn-secondary" data-action="stop" disabled>{{#str}}stoprecording, aienglishlesson{{/str}}</button>
          <p role="status" aria-live="polite" data-region="status"></p>
          <audio controls hidden data-region="preview"></audio>
          <a hidden data-region="download">{{#str}}downloadrecording, aienglishlesson{{/str}}</a>
          <label for="aiel-recording">{{#str}}uploadrecording, aienglishlesson{{/str}}</label>
          <input class="form-control" type="file" id="aiel-recording" name="recording" accept="audio/*,.webm,.m4a,.ogg,.wav,.mp3">
        </div>{{/speaking}}
        <p>{{#str}}noaistudent, aienglishlesson{{/str}}</p>
        <button type="submit" class="btn btn-primary my-2">{{#str}}submitresponse, aienglishlesson{{/str}}</button>
      </form>{{/cansave}}
      {{#submitted}}<p role="status">{{#str}}responsesaved, aienglishlesson{{/str}}</p>
        {{#recordingurl}}<audio controls preload="none" src="{{recordingurl}}">{{#str}}recording, aienglishlesson{{/str}}</audio>{{/recordingurl}}
        {{#feedback}}<section class="aiel-example"><h4>{{#str}}feedback, aienglishlesson{{/str}}</h4><p>{{#str}}feedbacknotice, aienglishlesson{{/str}}</p><div class="aiel-text">{{feedback}}</div></section>{{/feedback}}
        <form method="post" action="{{actionurl}}"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="version" value="{{version}}"><input type="hidden" name="section" value="{{section}}"><input type="hidden" name="action" value="clearresponse"><input type="hidden" name="sesskey" value="{{sesskey}}"><button class="btn btn-outline-secondary" type="submit">{{#str}}clearresponse, aienglishlesson{{/str}}</button></form>
      {{/submitted}}
    </section>{{/practice}}
    {{#teacher}}{{#answer}}<details><summary>{{#str}}answer, aienglishlesson{{/str}}</summary><div class="aiel-text">{{answer}}</div></details>{{/answer}}{{/teacher}}
    {{#cansave}}<form method="post" action="{{actionurl}}"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="version" value="{{version}}"><input type="hidden" name="section" value="{{section}}"><input type="hidden" name="action" value="progress"><input type="hidden" name="sesskey" value="{{sesskey}}"><button class="btn btn-primary my-3" type="submit">{{#str}}markcomplete, aienglishlesson{{/str}}</button></form>{{/cansave}}
    <div class="aiel-pagination">{{#previous}}<a class="btn btn-outline-secondary" href="{{previous}}">{{#str}}previous, aienglishlesson{{/str}}</a>{{/previous}}{{#next}}<a class="btn btn-outline-secondary" href="{{next}}">{{#str}}next, aienglishlesson{{/str}}</a>{{/next}}</div>
  </article>
</div>
